{
  "name": "nippotion",
  "version": "0.0.3",
  "description": "Deliver daily reports written in Notion to Slack channels based on their labels",
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "author": "Kenichi Takahashi",
  "license": "MIT",
  "dependencies": {
    "@holiday-jp/holiday_jp": "^2.5.1",
    "@notionhq/client": "^5.22.0",
    "@slack/web-api": "^8.0.0",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.6",
    "p-retry": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "10.8.1",
    "tsup": "8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion@1": "^5.0.8",
    "esbuild": "^0.28.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenchan/nippotion.git"
  },
  "bin": {
    "nippotion": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ]
}
